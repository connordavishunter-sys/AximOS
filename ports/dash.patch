+/* Reads a line through libc's line editor. Ctrl+C acts as it does on a command. */
+static int
+readedited(char *buf)
+{
+	static const char *const builtins[] = {
+		"alias", "bg", "cd", "command", "eval", "exec", "exit", "export", "fg", "hash",
+		"jobs", "local", "pwd", "read", "readonly", "return", "set", "shift", "source",
+		"test", "times", "trap", "type", "ulimit", "umask", "unalias", "unset", "wait",
+		NULL
+	};
+	struct stackmark smark;
+	const char *line;
+	size_t len;
+
+	pushstackmark(&smark, stackblocksize());
+	line = line_read(getprompt(NULL), builtins);
+	popstackmark(&smark);
+	if (!line) {
+		if (errno != EINTR)
+			return 0;
+		raise(SIGINT);
+		line = "";
+	}
+	len = strlen(line);
+	memcpy(buf, line, len);
+	buf[len] = '\n';
+	return len + 1;
+}
