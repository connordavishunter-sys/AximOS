# hostapd, for the Wi-Fi test's access point: nl80211 through libnl, with WPA2 and WPA3
# personal through OpenSSL.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CFLAGS += -O2 -w
