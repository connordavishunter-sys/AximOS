#!/bin/sh
# Compiles and links ported programs against AximOS's libc instead of the host's.
root=$(cd "$(dirname "$0")/.." && pwd)
cflags="-nostdinc -isystem $(gcc -print-file-name=include) -isystem $root/user/libc/include -isystem $root/abi
	-fno-stack-protector -fno-pic -fno-pie -fcf-protection=none -march=x86-64 -mno-red-zone -D__aximos__
	-fno-asynchronous-unwind-tables -fno-unwind-tables -ffunction-sections -fdata-sections"

for arg; do
	case $arg in
	-c | -E | -S | -M | -MM | -r | -Wl,-r | -print-* | --version | -dumpversion | -v)
		exec gcc $cflags "$@" ;;
	esac
done

# libc.a has everything, so libraries like libm are empty ones. Sharing an archive
# name with the host's would link in the host's.
mkdir -p "$root/build/ports/lib"
for lib in m rt pthread dl crypt util; do
	[ -e "$root/build/ports/lib/lib$lib.a" ] || ar rcs "$root/build/ports/lib/lib$lib.a"
done

exec gcc $cflags -static -no-pie -nostdlib -nostartfiles -L"$root/build/ports/lib" -Wl,-z,max-page-size=0x1000,-z,noexecstack,-z,noseparate-code,--gc-sections \
	-Wl,-Ttext-segment=0x400000 "$root/build/user/libc/crt0.o" "$@" \
	"$root/build/user/libc.a" -lgcc "$root/build/user/libc.a"
