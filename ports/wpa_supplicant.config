# What wpa_supplicant is built with: Linux's nl80211, through libnl, and OpenSSL, for
# open, WPA2 and WPA3 personal networks, which netd has it join through its control socket.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_OWE=y
CONFIG_SME=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CFLAGS += -O2 -w # its warnings are glibc 2.44 C23 const strchr, which are harmless
