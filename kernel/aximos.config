# What make changes in Arch's kernel config, which it builds on.

CONFIG_LOCALVERSION="-aximos"

# No debug info, BTF or Rust, which take much of the build's time and need more tools
CONFIG_DEBUG_INFO_NONE=y
CONFIG_RUST=n

# Never NVIDIA's GPUs: the screen's the Intel iGPU's, or the firmware's
CONFIG_DRM_NOUVEAU=n

# The disks it boots from, built in, so the kernel mounts the root itself, without an
# initramfs to load their modules first
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
