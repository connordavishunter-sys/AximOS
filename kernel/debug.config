# What make debug adds to the kernel's x86_64_defconfig: only what QEMU and the
# Lenovo 82Y3 need, built in, so it compiles quickly.

CONFIG_LOCALVERSION="-aximos-debug"

# Booting from Limine, with the system in an initramfs
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# The console: serial for the tests, and the screen the firmware left
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y

# QEMU's devices
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_E1000=y
CONFIG_HW_RANDOM_VIRTIO=y

# Disks and filesystems
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y

# Input
CONFIG_INPUT_EVDEV=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_STORAGE=y

# The Lenovo 82Y3: the Intel iGPU, its touchpad on I2C, the lid, power button and
# battery, and the backlight, which in its BIOS's dGPU mode is the EC's
CONFIG_DRM_I915=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_PINCTRL=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_WMI=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_NVIDIA_WMI_EC_BACKLIGHT=y
